# ---------- Nova configuration (copy to .env; every value is optional) ----------
NOVA_ENV=development
NOVA_LOG_LEVEL=INFO

# LLM provider: "ollama" (local, default) or "openai_compatible" (hosted endpoint)
NOVA_LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
# NOVA_LLM_TIMEOUT_S=600          # CPU-only Ollama is slow; lower on GPU / hosted

# Hosted OpenAI-compatible endpoint (requires: pip install -r requirements-optional.txt)
# NOVA_LLM_BASE_URL=https://api.openai.com/v1
# NOVA_LLM_API_KEY=
# NOVA_LLM_MODEL=gpt-4o-mini
# NOVA_EMBED_MODEL=text-embedding-3-small

# Market data: "auto" uses Alpha Vantage when a key is set, else Yahoo Finance (keyless, unofficial)
NOVA_FINANCE_PROVIDER=auto
ALPHAVANTAGE_API_KEY=

# Web search (DuckDuckGo, no key)
NOVA_SEARCH_ENABLED=true

# Human-in-the-loop default for API calls (UI has its own toggle)
NOVA_APPROVAL_REQUIRED=false

# API: set to require an X-API-Key header on every endpoint except /health and /ready
NOVA_API_KEY=

# Storage (relative paths resolve from the project root)
# NOVA_DATA_DIR=data

# Limits / RAG tuning (defaults shown)
# NOVA_MAX_MESSAGE_CHARS=4000
# NOVA_MAX_PDF_MB=20
# NOVA_MAX_PDF_PAGES=300
# NOVA_MIN_RELEVANCE=0.56

# Video / audio
NOVA_WHISPER_BACKEND=faster        # faster (faster-whisper, default) | openai (openai-whisper + FFmpeg)
WHISPER_MODEL=small                # tiny | base | small | medium | large-v3 (downloaded on first use)
NOVA_WHISPER_COMPUTE_TYPE=int8     # CPU-friendly quantisation
SARVAM_API_KEY=                    # Hinglish transcription (language=hinglish)
SARVAM_STT_MODEL=saaras:v2.5
NOVA_MEDIA_LLM_PROVIDER=default    # default (Nova's chat model) | mistral
MISTRAL_API_KEY=
MEDIA_MAX_SIZE_MB=500
MEDIA_MAX_DURATION_SECONDS=7200
VIDEO_CHUNK_SIZE=500
VIDEO_CHUNK_OVERLAP=1
VIDEO_CHUNK_MAX_SECONDS=120
# NOVA_VIDEO_MIN_RELEVANCE=0.55
NOVA_YOUTUBE_ENABLED=true

# Optional LangSmith tracing (disabled unless both are set)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nova
